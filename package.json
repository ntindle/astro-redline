		"index.d.ts",
		"app.js"
	],
	"keywords": [
		"astro-integration",
		"withastro",
		"astro",
		"dev-toolbar",
		"annotations",
		"review"
	],
	"peerDependencies": {
		"astro": ">=6.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ntindle/astro-redline.git"
	},
	"license": "MIT"
}
