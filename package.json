{
	"name": "astro-redline",
	"version": "0.1.0",
	"description": "Mark up pages in astro dev: notes, cuts and rewrites pinned to the page, saved to a file a coding agent can work through.",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.mjs"
		}
	},
	"files": [
